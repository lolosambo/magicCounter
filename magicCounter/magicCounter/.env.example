# Configuration Django - Magic Counter
# Copiez ce fichier en .env et modifiez les valeurs

# Clé secrète Django (générez-en une nouvelle avec la commande ci-dessous)
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-changez-cette-cle-secrete

# Mode debug (True pour développement, False pour production)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1
